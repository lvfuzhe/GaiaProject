{
  "config_version": 2,
  "profile": "training",
  "architecture_family": "graph_hybrid",
  "training_runtime": {
    "mode": "single_gpu",
    "device": "cuda:0",
    "ddp_enabled": false,
    "multi_gpu_enabled": false,
    "multi_node_enabled": false,
    "data_root_strategy": "local_per_player_count",
    "profile_execution": "one_profile_at_a_time",
    "active_profile_source": "supervisor_argument",
    "gpu_resource_policy": "cooperative_time_slicing",
    "gatekeeper_gpu_policy": "exclusive",
    "selfplay_pauses_during_gatekeeper": true,
    "max_active_profiles": 1,
    "process_count_per_profile": 5
  },
  "training": {
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "min_learning_rate": 0.00001,
    "scheduler": "cosine",
    "warmup_samples": 50000,
    "batch_size": 128,
    "gradient_accumulation_steps": 4,
    "effective_batch_size": 512,
    "weight_decay": 0.0001,
    "amp": true,
    "amp_dtype": "float16",
    "gradient_clip_norm": 1.0,
    "checkpoint_every_samples": 10000,
    "validation_fraction": 0.05,
    "loss_weights": {
      "policy": 1.0,
      "pairwise_wdl": 1.0,
      "vp_belief": 0.5
    },
    "label_smoothing": 0.0,
    "validation_split_policy": "setup_hash_holdout",
    "initial_champion_policy": "zero_compensation_bootstrap"
  },
  "observation_schema": {
    "version": "standard-v22",
    "dtype": "float32",
    "max_graph_nodes": 128,
    "max_graph_edges": 512,
    "relation_type_count": 16,
    "max_players": 4,
    "player_dimension_policy": "exact_profile_count",
    "input_shape_by_profile": true,
    "global_token_count": 1,
    "player_order": "absolute_seat_order",
    "padding": "zero_with_explicit_masks",
    "gnn_operator": "edge_conditioned_graph_transformer",
    "activation": "silu",
    "normalization": "pre_layernorm",
    "normalization_constants": {
      "vp_scale": 100.0,
      "resource_scale": 20.0,
      "tech_level_scale": 5.0,
      "round_scale": 6.0
    },
    "include_starting_vp_offset": true
  },
  "action_schema": {
    "version": "action-tuple-v1",
    "action_registry": "rules_engine_action_registry_v1",
    "parameter_factorization": "conditional_independent_slots",
    "parameter_slot_count": 8,
    "max_legal_actions": 256,
    "tuple_prior_aggregation": "sum_log_prob_then_normalize",
    "canonicalization": "type_then_fixed_slot_order",
    "invalid_parameter_logit": -1000000000.0,
    "empty_slot_policy": "masked",
    "fixed_action_id_role": "audit_and_cache_only"
  },
  "network": {
    "network_config_id": "graph-hybrid-v1",
    "capacity": {
      "hidden_size": 256,
      "hybrid_blocks": 12,
      "attention_heads": 8,
      "ffn_hidden_size": 512,
      "relation_embedding_size": 64,
      "global_token_count": 1,
      "dropout": 0.0
    },
    "heads": [
      "parameterized_policy",
      "pairwise_wdl",
      "vp_belief"
    ],
    "vp_belief": {
      "main_min": -200,
      "main_max": 200,
      "step": 1,
      "underflow_bucket": true,
      "overflow_bucket": true,
      "output_buckets": 403,
      "underflow_representative": -201,
      "overflow_representative": 201,
      "target_encoding": "hard_bucket_cross_entropy",
      "label_smoothing": 0.0,
      "moment_method": "softmax_expectation_with_tail_representatives"
    }
  },
  "network_change_policy": {
    "capacity_change": "start_new_training_line",
    "architecture_or_schema_change": "start_new_training_line",
    "checkpoint_resume": "exact_network_config_hash_only"
  },
  "swa": {
    "enabled": true,
    "start_after_samples": 200000,
    "update_every_samples": 1000,
    "averaging": "equal_weight_rolling",
    "snapshot_count": 32,
    "window_semantics": "most_recent_snapshots_only",
    "reset_on_compensation_version_change": "large_change_only",
    "device": "cpu",
    "resume_policy": "restore_state"
  },
  "setup_distribution": {
    "provider": "boardgamearena",
    "game": "gaia_project",
    "rules_reference": "bga_random_setup",
    "version": "bga-random-v1",
    "golden_fixture_manifest": "tests/fixtures/bga_setup_golden.json",
    "golden_fixture_source": "BGA random setup outputs captured from the setup UI/replays and manually verified",
    "fixture_status": "to_be_generated",
    "fixture_min_setups": 256,
    "fixture_seed_policy": "fixed_seed_manifest",
    "version_source_policy": "project_versioned_from_bga_rule_reference",
    "require_setup_hash": true
  },
  "data": {
    "raw_format": "npz-trajectory-v1",
    "one_file_per_game": true,
    "complete_state_trace": true,
    "compressed_npz": true,
    "state_trace_encoding": "typed_arrays_v1",
    "storage_dtype": "float16_for_observations_float32_for_targets",
    "shuffle": {
      "output_format": "npz-shard-v1",
      "positions_per_shard": 4096,
      "seed": 20260828,
      "scan_interval_seconds": 10,
      "deduplicate_by_game_id": true,
      "preserve_game_boundaries_in_raw": true
    },
    "window": {
      "min_positions": 200000,
      "max_positions": 2000000,
      "fresh_data_fraction_min": 0.25,
      "age_weighting": "linear_taper",
      "no_repeat_shard_until_window_refresh": true
    },
    "validation": {
      "split_unit": "setup_hash",
      "holdout_setup_count": 32,
      "allow_training_games_in_holdout": false
    }
  },
  "training_isolation": {
    "mode": "independent_by_player_count",
    "allowed_player_counts": [
      2,
      3,
      4
    ],
    "cross_player_count_replay": false,
    "cross_player_count_checkpoint": false,
    "cross_player_count_gatekeeper": false
  },
  "player_profiles": {
    "2": {
      "player_count": 2,
      "network_id": "graph-hybrid-2p",
      "pipeline_root": "runs/pipeline-2p"
    },
    "3": {
      "player_count": 3,
      "network_id": "graph-hybrid-3p",
      "pipeline_root": "runs/pipeline-3p"
    },
    "4": {
      "player_count": 4,
      "network_id": "graph-hybrid-4p",
      "pipeline_root": "runs/pipeline-4p"
    }
  },
  "search": {
    "tier_ratio_semantics": "observed_target_share",
    "tier_targets": {
      "forced": 0.30,
      "cheap": 0.45,
      "full": 0.25
    },
    "non_forced_search_mix": {
      "cheap": 0.6428571429,
      "full": 0.3571428571
    },
    "minimum_full_coverage": {
      "per_round": 0.20,
      "per_action_class": 0.20,
      "per_player_count": 0.20
    },
    "budgets": {
      "forced_simulations": 0,
      "cheap_simulations": 32,
      "full_simulations": 128,
      "lead_estimation_enabled": false,
      "lead_estimation_ratio": 0.0,
      "lead_estimation_simulations": 256
    },
    "policy_targets": {
      "forced": {
        "policy_train_mask": 0,
        "policy_weight": 0.0
      },
      "cheap": {
        "policy_train_mask": 0,
        "policy_weight": 0.0
      },
      "full": {
        "policy_train_mask": 1,
        "policy_weight": 1.0
      },
      "lead_estimation": {
        "policy_train_mask": 0,
        "policy_weight": 0.0
      }
    },
    "mcts": {
      "c_puct": 1.5,
      "fpu": "parent_value",
      "fpu_reduction": 0.20,
      "virtual_loss": 1.0,
      "max_tree_nodes": 200000,
      "leaf_batch_size": 64,
      "leaf_batch_wait_ms": 2,
      "tie_break": "canonical_action_tuple_order",
      "tree_reuse": false,
      "transposition_table": false,
      "root_noise_enabled": true,
      "root_noise_total_concentration": 10.0,
      "action_temperature": 1.0,
      "gatekeeper_action_temperature": 0.0,
      "root_noise_by_action_type": "dirichlet_over_legal_tuples",
      "tier_scheduler": "quota_controller_with_minimum_coverage",
      "tier_quota_tolerance": 0.05
    },
    "vp_utility": {
      "enabled": true,
      "apply_in": [
        "mcts_leaf_backup",
        "terminal_backup"
      ],
      "pairwise_weight": 1.0,
      "beta_vp": 0.10,
      "vp_scale": 20.0,
      "center": {
        "source": "root_vp_belief_mean",
        "score_basis": "adjusted_final_vp",
        "include_starting_vp_offset": true,
        "freeze_scope": "single_mcts_search"
      },
      "transform": "tanh",
      "non_terminal_source": "vp_belief_mean",
      "terminal_source": "exact_final_vp",
      "formula": "u = pairwise_utility + beta_vp * tanh((vp_i - root_center_i) / vp_scale)"
    }
  },
  "gatekeeper": {
    "primary_metric": "mean_pairwise_utility",
    "confidence_method": "block_bootstrap",
    "confidence_level": 0.95,
    "min_pairing_blocks": 200,
    "max_pairing_blocks": 1000,
    "pairing": {
      "block_definition": "fixed_setup_candidate_rotates_all_seats",
      "same_setup_within_block": true,
      "candidate_seat_rotation": "all_seats",
      "games_per_block_formula": "player_count",
      "total_games_formula": "pairing_blocks * player_count"
    },
    "pass_lower_ci": 0.02,
    "reject_upper_ci": 0.0,
    "candidate_seat_rotation": "all_seats",
    "root_noise_enabled": false,
    "action_temperature": 0.0,
    "delta_k": 0,
    "bootstrap_setup_pool": "bga_golden_fixture_and_fixed_seeds",
    "bootstrap_seed_policy": "fixed_manifest_seed_per_block",
    "bootstrap_unit": "pairing_block",
    "candidate_queue_policy": "fifo_one_candidate_at_a_time",
    "first_champion_source": "zero_compensation_bootstrap",
    "control_disable_vp_for_both_models": true,
    "vp_utility_control": {
      "enabled": true,
      "beta_vp": 0.0,
      "run_when": "after_primary_pass_before_publish",
      "frequency": "every_primary_passing_candidate",
      "decision": "regression_veto_only",
      "regression_reject_upper_ci": -0.02,
      "reuse_primary_pairing_blocks": true,
      "pairing_block_definition": "same_as_gatekeeper_primary",
      "min_pairing_blocks": 200,
      "max_pairing_blocks": 1000,
      "confidence_level": 0.95
    },
    "protection_limits": {
      "illegal_action_rate_max": 0.0,
      "crash_rate_max": 0.0,
      "incomplete_game_rate_max": 0.0,
      "timeout_rate_max": 0.01
    }
  },
  "tensorrt": {
    "precision": "fp16",
    "validation_precision": "fp32",
    "allow_tf32": true,
    "hardware": {
      "backend": "cuda",
      "device_ids": [
        "0"
      ],
      "target_gpu": "auto",
      "min_compute_capability": "auto",
      "workspace_size_mb": 4096
    },
    "engine_cache_dir": "runs/tensorrt-cache",
    "rebuild_on_onnx_hash_change": true
  },
  "export": {
    "onnx_opset": 18,
    "dynamic_batch": true,
    "batch_profile": {
      "min": 1,
      "opt": 64,
      "max": 256
    },
    "input_names": ["observation"],
    "output_names": [
      "action_type_logits",
      "action_argument_logits",
      "pairwise_wdl_logits",
      "vp_belief_logits"
    ],
    "max_abs_error_fp32": 0.0001,
    "max_relative_error_fp32": 0.001,
    "max_abs_error_fp16": 0.01,
    "max_relative_error_fp16": 0.02
  },
  "vp_offset": {
    "mode": "offline_integer_zero_sum",
    "training_perturbation": {
      "enabled": true,
      "distribution": "uniform_integer_zero_sum",
      "max_abs_per_player": 4,
      "apply_to_new_games_only": true
    },
    "fit": {
      "min_games_per_context": 200,
      "regularization": "ridge",
      "ridge_lambda": 0.1,
      "objective_weights": {
        "first_place_rate": 1.0,
        "mean_rank": 1.0,
        "pairwise_utility": 1.0
      },
      "stop_max_abs_delta": 1,
      "stop_consecutive_rounds": 3
    }
  }
}
